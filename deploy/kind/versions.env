# The throwaway cluster `run.sh` makes. Sourced by run.sh and check.sh.
# kind v0.33.0's oldest node image: the closest to the chart's floor (Kubernetes 1.30) and to
# EKS's supported versions. kubectl in the Dockerfile stays within one minor version of it.
NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
KUBERNETES_VERSION=1.34.11
REGISTRY_IMAGE=registry:3.0.0@sha256:6c5666b861f3505b116bb9aa9b25175e71210414bd010d92035ff64018f9457e
CLUSTER=argus-kind
REGISTRY_NAME=argus-kind-registry
# On the host's loopback only.
REGISTRY_PORT=5001
NAMESPACE=argus
RELEASE=argus
