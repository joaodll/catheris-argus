{
  "about": "A rule triggers each target (function qualifier dropped, a queue). A rule with no targets (null) gives no edge.",
  "resources": [
    {
      "uid": "arn:aws:events:us-east-1:123456789012:rule/nightly",
      "type": "aws_eventbridge_rule",
      "native_id": "nightly",
      "name": null,
      "region": "us-east-1",
      "config": {
        "targets": [
          {
            "Id": "1",
            "Arn": "arn:aws:lambda:us-east-1:123456789012:function:orders:live"
          },
          {
            "Id": "2",
            "Arn": "arn:aws:sqs:us-east-1:123456789012:orders-queue"
          }
        ]
      }
    },
    {
      "uid": "arn:aws:events:us-east-1:123456789012:rule/idle",
      "type": "aws_eventbridge_rule",
      "native_id": "idle",
      "name": null,
      "region": "us-east-1",
      "config": {
        "targets": null
      }
    }
  ],
  "expected": [
    {
      "source": "arn:aws:events:us-east-1:123456789012:rule/nightly",
      "target": "arn:aws:lambda:us-east-1:123456789012:function:orders",
      "attributes": {}
    },
    {
      "source": "arn:aws:events:us-east-1:123456789012:rule/nightly",
      "target": "arn:aws:sqs:us-east-1:123456789012:orders-queue",
      "attributes": {}
    }
  ]
}
