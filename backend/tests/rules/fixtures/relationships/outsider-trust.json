                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "uid": "arn:aws:iam::123456789012:role/github-repo",
      "type": "aws_iam_role",
      "native_id": "github-repo",
      "name": "github-repo",
      "region": "global",
      "vpc_id": null,
      "config": {
        "name": "github-repo",
        "assume_role_policy_std": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sts:assumerolewithwebidentity"
              ],
              "Principal": {
                "Federated": [
                  "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
                ]
              },
              "Condition": {
