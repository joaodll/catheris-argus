      "region": "global",
      "vpc_id": null,
      "config": {
        "name": "github-any",
        "assume_role_policy_std": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sts:assumerolewithwebidentity"
