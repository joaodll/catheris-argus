{
  "about": "Principals outsiders control in a role's trust: another account's root or role, a bare account id, anyone (with or without a condition), a GitHub OIDC trust with no subject condition. Near misses: the account's own root, a service, an OIDC trust scoped to a repository (sub), a SAML provider, a Deny statement.",
  "resources": [
    {
      "uid": "arn:aws:iam::123456789012:role/partner",
      "type": "aws_iam_role",
      "native_id": "partner",
      "name": "partner",
      "region": "global",
      "vpc_id": null,
      "config": {
        "name": "partner",
        "assume_role_policy_std": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sts:assumerole"
              ],
              "Principal": {
                "AWS": [
                  "arn:aws:iam::999988887777:root"
                ]
              }
            }
          ]
        }
      }
    },
    {
