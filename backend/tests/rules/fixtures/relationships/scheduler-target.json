{
  "about": "A schedule triggers its target, a Lambda alias as its function. Near miss: a target without an ARN.",
  "resources": [
    {
      "uid": "arn:aws:scheduler:us-east-1:123456789012:schedule/default/nightly",
      "type": "aws_scheduler_schedule",
      "native_id": "nightly",
      "name": "nightly",
      "region": "us-east-1",
      "config": {
        "target": {
          "Arn": "arn:aws:lambda:us-east-1:123456789012:function:orders:live",
          "RoleArn": "arn:aws:iam::123456789012:role/sched"
        }
      }
    },
    {
      "uid": "arn:aws:scheduler:us-east-1:123456789012:schedule/default/broken",
      "type": "aws_scheduler_schedule",
      "native_id": "broken",
      "name": "broken",
      "region": "us-east-1",
      "config": {
        "target": {
          "Arn": null
        }
      }
    }
  ],
  "expected": [
    {
      "source": "arn:aws:scheduler:us-east-1:123456789012:schedule/default/nightly",
      "target": "arn:aws:lambda:us-east-1:123456789012:function:orders",
      "attributes": {}
    }
  ]
}
