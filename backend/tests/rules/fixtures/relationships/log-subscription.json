{
  "about": "A log group's subscription filter -> its destination (a function, its alias dropped). Near miss: a filter on a log group in another region.",
  "resources": [
    {
      "uid": "arn:aws:logs:us-east-1:123456789012:log-group:/app/orders:*",
      "type": "aws_cloudwatch_log_group",
      "native_id": "/app/orders",
      "name": "/app/orders",
      "region": "us-east-1",
      "config": {
        "name": "/app/orders"
      }
    },
    {
      "uid": "arn:aws:logs:us-east-1:123456789012:log-group:/app/orders:subscription-filter:ship",
      "type": "aws_cloudwatch_log_subscription_filter",
      "native_id": "ship",
      "name": "ship",
      "region": "us-east-1",
      "config": {
        "log_group_name": "/app/orders",
        "destination_arn": "arn:aws:lambda:us-east-1:123456789012:function:orders:live"
      }
    },
    {
      "uid": "arn:aws:logs:eu-west-1:123456789012:log-group:/app/orders:subscription-filter:far",
      "type": "aws_cloudwatch_log_subscription_filter",
      "native_id": "far",
      "name": "far",
      "region": "eu-west-1",
      "config": {
        "log_group_name": "/app/orders",
        "destination_arn": "arn:aws:lambda:us-east-1:123456789012:function:orders"
      }
    }
  ],
  "expected": [
    {
      "source": "arn:aws:logs:us-east-1:123456789012:log-group:/app/orders:*",
      "target": "arn:aws:lambda:us-east-1:123456789012:function:orders",
      "attributes": {
        "filter": "ship"
      }
    }
  ]
}
