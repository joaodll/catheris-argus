{
  "about": "Users, groups and roles have each attached managed policy, AWS-managed or the customer's; another type's attached_policy_arns and a non-ARN entry give no edge.",
  "resources": [
    {"uid": "arn:aws:iam::123456789012:user/deploy", "type": "aws_iam_user", "native_id": "AIDAFIXTURE0000000001", "config": {"name": "deploy", "attached_policy_arns": ["arn:aws:iam::123456789012:policy/deploy-policy", "not-an-arn"]}},
    {"uid": "arn:aws:iam::123456789012:group/admins", "type": "aws_iam_group", "native_id": "AGPAFIXTURE0000000001", "config": {"name": "admins", "attached_policy_arns": ["arn:aws:iam::aws:policy/AdministratorAccess"]}},
    {"uid": "arn:aws:iam::123456789012:role/app", "type": "aws_iam_role", "native_id": "AROAFIXTURE0000000001", "config": {"name": "app", "attached_policy_arns": null}},
    {"uid": "arn:aws:iam::123456789012:policy/deploy-policy", "type": "aws_iam_policy", "native_id": "ANPAFIXTURE0000000001", "config": {"name": "deploy-policy", "attached_policy_arns": ["arn:aws:iam::123456789012:policy/other"]}}
  ],
  "expected": [
    {"source": "arn:aws:iam::123456789012:user/deploy", "target": "arn:aws:iam::123456789012:policy/deploy-policy", "attributes": {"managed_by": "customer"}},
    {"source": "arn:aws:iam::123456789012:group/admins", "target": "arn:aws:iam::aws:policy/AdministratorAccess", "attributes": {"managed_by": "aws"}}
  ]
}
