{
  "about": "A bucket notifies a function (twice: one edge), a queue and a topic. A bucket with no notifications (null) gives no edge.",
  "resources": [
    {
      "uid": "arn:aws:s3:::assets-bucket",
      "type": "aws_s3_bucket",
      "native_id": "assets-bucket",
      "name": null,
      "region": "us-east-1",
      "config": {
        "event_notification_configuration": {
          "LambdaFunctionConfigurations": [
            {
              "LambdaFunctionArn": "arn:aws:lambda:us-east-1:123456789012:function:orders",
              "Events": [
                "s3:ObjectCreated:*"
              ]
            },
            {
              "LambdaFunctionArn": "arn:aws:lambda:us-east-1:123456789012:function:orders",
              "Events": [
                "s3:ObjectRemoved:*"
              ]
            }
          ],
          "QueueConfigurations": [
            {
              "QueueArn": "arn:aws:sqs:us-east-1:123456789012:orders-queue"
            }
          ],
          "TopicConfigurations": [
            {
              "TopicArn": "arn:aws:sns:us-east-1:123456789012:alerts"
            }
          ]
        }
      }
    },
    {
      "uid": "arn:aws:s3:::quiet-bucket",
      "type": "aws_s3_bucket",
      "native_id": "quiet-bucket",
      "name": null,
      "region": "us-east-1",
      "config": {
        "event_notification_configuration": null
      }
    }
  ],
  "expected": [
    {
      "source": "arn:aws:s3:::assets-bucket",
      "target": "arn:aws:lambda:us-east-1:123456789012:function:orders",
      "attributes": {}
    },
    {
      "source": "arn:aws:s3:::assets-bucket",
      "target": "arn:aws:sqs:us-east-1:123456789012:orders-queue",
      "attributes": {}
    },
    {
      "source": "arn:aws:s3:::assets-bucket",
      "target": "arn:aws:sns:us-east-1:123456789012:alerts",
      "attributes": {}
    }
  ]
}
