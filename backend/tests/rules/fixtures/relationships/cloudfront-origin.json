{
  "about": "Origins: a bucket (regional S3 name), a load balancer, an HTTP API's default endpoint, and a custom host nobody owns (external). A distribution with no origins gives no edge.",
  "resources": [
    {
      "uid": "arn:aws:s3:::assets-bucket",
      "type": "aws_s3_bucket",
      "native_id": "assets-bucket",
      "name": null,
      "region": "us-east-1",
      "config": {}
    },
    {
      "uid": "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/web/1111",
      "type": "aws_ec2_application_load_balancer",
      "native_id": "web",
      "name": null,
      "region": "us-east-1",
      "config": {
        "dns_name": "web-1111.us-east-1.elb.amazonaws.com"
      }
    },
    {
      "uid": "arn:aws:apigateway:us-east-1::/apis/xyz789",
      "type": "aws_api_gatewayv2_api",
      "native_id": "xyz789",
      "name": null,
      "region": "us-east-1",
      "config": {}
    },
    {
      "uid": "arn:aws:cloudfront::123456789012:distribution/E1AAAA",
      "type": "aws_cloudfront_distribution",
      "native_id": "E1AAAA",
      "name": null,
      "region": "us-east-1",
      "config": {
        "domain_name": "d111abcdef8.cloudfront.net",
        "origins": [
          {
            "Id": "s3",
            "DomainName": "assets-bucket.s3.us-east-1.amazonaws.com"
          },
          {
            "Id": "alb",
            "DomainName": "WEB-1111.US-EAST-1.ELB.AMAZONAWS.COM"
          },
          {
            "Id": "api",
            "DomainName": "xyz789.execute-api.us-east-1.amazonaws.com"
          },
          {
            "Id": "legacy",
            "DomainName": "legacy.partner.example.org"
          }
        ]
      }
    },
    {
      "uid": "arn:aws:cloudfront::123456789012:distribution/E3ITEMS",
      "type": "aws_cloudfront_distribution",
      "native_id": "E3ITEMS",
      "name": null,
      "region": "us-east-1",
      "config": {
        "origins": {
          "Quantity": 1,
          "Items": [
            {
              "Id": "s3",
              "DomainName": "assets-bucket.s3.amazonaws.com"
            }
          ]
        }
      }
    },
    {
      "uid": "arn:aws:cloudfront::123456789012:distribution/E4NONE",
      "type": "aws_cloudfront_distribution",
      "native_id": "E4NONE",
      "name": null,
      "region": "us-east-1",
      "config": {
        "origins": null
      }
    }
  ],
  "expected": [
    {
      "source": "arn:aws:cloudfront::123456789012:distribution/E1AAAA",
      "target": "arn:aws:s3:::assets-bucket",
      "attributes": {
        "origin_id": "s3"
      }
    },
    {
      "source": "arn:aws:cloudfront::123456789012:distribution/E1AAAA",
      "target": "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/web/1111",
      "attributes": {
        "origin_id": "alb"
      }
    },
    {
      "source": "arn:aws:cloudfront::123456789012:distribution/E1AAAA",
      "target": "arn:aws:apigateway:us-east-1::/apis/xyz789",
      "attributes": {
        "origin_id": "api"
      }
    },
    {
      "source": "arn:aws:cloudfront::123456789012:distribution/E1AAAA",
      "target": "external:legacy.partner.example.org",
      "attributes": {
        "origin_id": "legacy"
      }
    },
    {
      "source": "arn:aws:cloudfront::123456789012:distribution/E3ITEMS",
      "target": "arn:aws:s3:::assets-bucket",
      "attributes": {
        "origin_id": "s3"
      }
    }
  ]
}
