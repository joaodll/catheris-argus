# Copy to .env (git-ignored) and fill in. Never commit the copy.
# Generate values with the admin-tools service:
#   docker compose run --rm admin-tools hash-password     -> ARGUS_BOOTSTRAP_ADMIN_PASSWORD_HASH
#   docker compose run --rm admin-tools new-secret-key    -> ARGUS_SECRET_KEYS, ARGUS_SECRET_KEY_ID

# --- Every setup -------------------------------------------------------------------------
# The first admin, created once by migrate (ADR-0041): a password, or its hash. Start the stack,
# sign in, then delete the password line. More users are added in Administration -> Users.
ARGUS_BOOTSTRAP_ADMIN_USERNAME=admin
ARGUS_BOOTSTRAP_ADMIN_PASSWORD_HASH=
# ARGUS_BOOTSTRAP_ADMIN_PASSWORD=
# Keyring for stored connection secrets: "k2:<base64>,k1:<base64>"; the id names the current key.
ARGUS_SECRET_KEYS=
ARGUS_SECRET_KEY_ID=

# --- The operator's limits (optional) --------------------------------------------------
# Their defaults are shown. On Kubernetes they are chart values (charts/argus/values.yaml).
# ARGUS_SESSION_IDLE_MINUTES=30
# ARGUS_SESSION_ABSOLUTE_HOURS=12
# ARGUS_LOGIN_MAX_FAILURES=5
# ARGUS_LOGIN_LOCKOUT_MINUTES=15
# ARGUS_LOGIN_MAX_FAILURES_PER_IP=20
# ARGUS_LOGIN_MAX_FAILURES_PER_USERNAME=100
# Lowering this below what is set in the UI deletes the history above it at the next retention.
# ARGUS_MAX_HISTORY_DAYS=400

# --- Local development only (optional) ---------------------------------------------------
# Without these, compose.yaml uses fixed development passwords. Fine on a laptop, never elsewhere.
# ARGUS_DEV_DB_PASSWORD=
# ARGUS_DEV_API_DB_PASSWORD=
# ARGUS_DEV_WORKER_DB_PASSWORD=
# Browser walk: docker compose run --rm e2e
# ARGUS_E2E_PASSWORD=

# --- Single instance (required by compose.single-instance.yaml) ------------------
# ARGUS_DB_PASSWORD=
# ARGUS_API_DB_PASSWORD=
# ARGUS_WORKER_DB_PASSWORD=
