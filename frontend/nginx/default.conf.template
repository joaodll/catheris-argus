# One origin: the static app and /api. The API is never published on its own.
# A template: at start the image's entrypoint writes it to /etc/nginx/conf.d/default.conf with
# ${ARGUS_*} variables filled in (NGINX_ENVSUBST_FILTER), so nginx's own $variables stay as
# they are. ARGUS_API_UPSTREAM is the API's address: api:8000 in Compose, the chart's Service
# on Kubernetes.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass http://${ARGUS_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite, never append: the API trusts this header from nginx only, so it must hold
        # the real peer address and nothing the client sent.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Hashed file names: safe to cache for good.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes all serve the app; the shell itself is never cached.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
