# One origin: the static app and /api. The API is never published on its own.
# A template: at start the image's entrypoint writes it to /etc/nginx/conf.d/default.conf with
# ${ARGUS_*} variables filled in (NGINX_ENVSUBST_FILTER), so nginx's own $variables stay as
# they are. ARGUS_API_UPSTREAM is the API's address: api:8000 in Compose, the chart's Service
# on Kubernetes.

# After real IP handling, so behind an ingress this counts each client, not the ingress.
limit_req_zone $binary_remote_addr zone=sign_in:1m rate=1r/s;
# SSO (ADR-0048): starting a sign-in is cheap (no XML is read), and people behind one office
# address must not share the password zone's rate. The IdP's answer is checked in a process of its
# own, a few at a time per API pod, so one address may post only as fast as a person signs in.
limit_req_zone $binary_remote_addr zone=sso:1m rate=10r/s;
limit_req_zone $binary_remote_addr zone=sso_answer:1m rate=1r/s;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;
    # Empty unless an ingress is in front (the chart's web.ingress): then who connects here is the
    # ingress, and this takes the client from the last X-Forwarded-For entry, the one it adds, so
    # $remote_addr below is that client.
    ${ARGUS_NGINX_REAL_IP}

    # Anyone can ask for a password check here, so one address can't ask for many: nobody types a
    # password this fast, and each check holds 64 MiB in the API. Each web pod counts on its own.
    location = /api/v1/auth/sign-in {
        limit_req zone=sign_in burst=5 nodelay;
        limit_req_status 429;
        error_page 429 = @sign_in_limited;
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_read_timeout 30s;
        proxy_pass http://${ARGUS_API_UPSTREAM};
    }

    location @sign_in_limited {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Retry-After 5 always;
        default_type application/json;
        return 429 '{"detail":"too many attempts"}';
    }

    # SSO's start and the IdP's answer are page navigations, so a refusal is a redirect to the
    # sign-in page with a reason, never a JSON page. The answer is a form post of a signed XML
    # document; only here may a body be that large, and the API checks its own limit too.
    location = /api/v1/auth/saml/login {
        limit_req zone=sso burst=20 nodelay;
        limit_req_status 429;
        error_page 429 = @sso_limited;
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_read_timeout 30s;
        proxy_pass http://${ARGUS_API_UPSTREAM};
    }

    location = /api/v1/auth/saml/acs {
        limit_req zone=sso_answer burst=5 nodelay;
        limit_req_status 429;
        error_page 429 = @sso_limited;
        client_max_body_size 256k;
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_read_timeout 30s;
        proxy_pass http://${ARGUS_API_UPSTREAM};
    }

    # Relative, so behind a TLS ingress the browser stays on the address it used.
    location @sso_limited {
        include /etc/nginx/snippets/security-headers.conf;
        absolute_redirect off;
        return 303 /sign-in?reason=sso-busy;
    }

    # Readiness and health checks: nginx itself, never the API. A Service keeps web while the API
    # or its database is down, so the app can still load and say Argus can't be reached.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # A report's file (ADR-0047): streamed to the browser as the API sends it. Buffered, nginx
    # would write a large one to a temporary file first, and web's disk is read-only; it can also
    # take longer than an API answer.
    location ~ ^/api/v1/reports/[0-9]+/download$ {
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://${ARGUS_API_UPSTREAM};
    }

    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_read_timeout 30s;
        proxy_pass http://${ARGUS_API_UPSTREAM};
    }

    # Hashed file names: safe to cache for good.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes all serve the app; the shell itself is never cached.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
