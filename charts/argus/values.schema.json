{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatherIs Argus values",
  "description": "ADR-0039, ADR-0040. Unknown keys are refused, so a typo cannot turn a control off silently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "secrets",
    "api",
    "postgres",
    "networkPolicy",
    "admissionPolicy",
    "identity"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "images": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        },
        "runtime": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^@:]+(:[0-9]+)?(/[^@:]+)*$",
              "description": "Without a tag: the image is pulled by digest only."
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "required: sha256:<64 hex>"
            }
          },
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ]
        },
        "worker": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^@:]+(:[0-9]+)?(/[^@:]+)*$",
              "description": "Without a tag: the image is pulled by digest only."
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "required: sha256:<64 hex>"
            }
          },
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ]
        },
        "web": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^@:]+(:[0-9]+)?(/[^@:]+)*$",
              "description": "Without a tag: the image is pulled by digest only."
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "required: sha256:<64 hex>"
            }
          },
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ]
        },
        "postgres": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^@:]+(:[0-9]+)?(/[^@:]+)*$",
              "description": "Without a tag: the image is pulled by digest only."
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "required: sha256:<64 hex>"
            }
          },
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "runtime",
        "worker",
        "web",
        "postgres"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "required: the Secret holding every key"
        }
      },
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ]
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "refreshInterval": {
          "type": "string"
        },
        "apiVersion": {
          "type": "string",
          "enum": [
            "external-secrets.io/v1",
            "external-secrets.io/v1beta1"
          ]
        },
        "secretStoreRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "SecretStore",
                "ClusterSecretStore"
              ]
            }
          },
          "additionalProperties": false
        },
        "remoteKey": {
          "type": "string"
        },
        "bootstrapKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ARGUS_BOOTSTRAP_ADMIN_PASSWORD",
              "ARGUS_BOOTSTRAP_ADMIN_PASSWORD_HASH"
            ]
          }
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "secretStoreRef": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "remoteKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "database": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ownerUser": {
          "type": "string",
          "minLength": 1
        },
        "pools": {
          "type": "object",
          "properties": {
            "api": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "scheduler": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "scanJob": {
              "type": "integer",
              "minimum": 3,
              "maximum": 50
            },
            "task": {
              "type": "integer",
              "minimum": 2,
              "maximum": 50
            }
          },
          "required": [
            "api",
            "scheduler",
            "scanJob",
            "task"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClassName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ]
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "external": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "sslmode": {
              "type": "string",
              "enum": [
                "disable",
                "prefer",
                "require",
                "verify-ca",
                "verify-full"
              ]
            },
            "caConfigMap": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "external": {
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "required when postgres.enabled is false"
              }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "trustedProxies": {
          "type": "string",
          "minLength": 1,
          "description": "required: web's pod address range"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ]
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 10,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "targetCPUUtilizationPercentage"
          ]
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "trustedProxies"
      ]
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ]
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 10,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "targetCPUUtilizationPercentage"
          ]
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "tlsSecretName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "maxRunJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxTestJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ]
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "serviceAccounts": {
      "type": "object",
      "properties": {
        "run": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "scheduler": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scanJobs": {
      "type": "object",
      "properties": {
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ]
        },
        "tmpSize": {
          "type": "string",
          "minLength": 1
        },
        "scratch": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "size"
          ]
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "irsa",
            "podIdentity",
            "none"
          ]
        },
        "roleArn": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "if": {
        "properties": {
          "mode": {
            "const": "irsa"
          }
        }
      },
      "then": {
        "required": [
          "roleArn"
        ],
        "properties": {
          "roleArn": {
            "type": "string",
            "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$",
            "description": "required with mode irsa: the platform role's ARN"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 9
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ]
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "kubeApi": {
          "type": "object",
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "scanEgressExcept": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "ipv6": {
          "type": "boolean"
        },
        "scanEgressExceptIPv6": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "webIngressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "kubeApi": {
            "required": [
              "cidrs"
            ],
            "properties": {
              "cidrs": {
                "minItems": 1
              }
            }
          },
          "scanEgressExcept": {
            "contains": {
              "const": "169.254.0.0/16"
            }
          }
        }
      }
    },
    "admissionPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "acknowledgeUnenforced": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "acknowledgeUnenforced"
        ],
        "properties": {
          "acknowledgeUnenforced": {
            "const": true,
            "description": "turning the policy off must be acknowledged"
          }
        }
      }
    },
    "resourceQuota": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pods": {
          "type": "integer",
          "minimum": 0
        },
        "jobs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "external": {
                "required": [
                  "cidrs"
                ],
                "properties": {
                  "cidrs": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
